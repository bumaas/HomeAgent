{
  "elements": [
    {
      "type": "Label",
      "caption": "Assistants query and control your home through this module. They only see what you release under \"Devices\" and \"Scenes\"; to set up, first create an access under \"Endpoint and accesses\"."
    },
    {
      "type": "ExpansionPanel",
      "name": "PanelAccesses",
      "caption": "Endpoint and accesses",
      "onClick": "HAGT_UITogglePanel($id, 'PanelAccesses');",
      "items": [
        {
          "type": "Label",
          "name": "Endpoint",
          "caption": "Endpoint"
        },
        {
          "type": "Label",
          "caption": "Accesses with the token in the address use the endpoint followed by /<Token>. The address then contains the token and can end up in logs."
        },
        {
          "type": "List",
          "name": "Accesses",
          "caption": "Accesses (one per assistant, each with its own token)",
          "add": true,
          "delete": true,
          "rowCount": 4,
          "columns": [
            {
              "caption": "Name",
              "name": "Name",
              "width": "180px",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "caption": "Token (at least 24 characters, sent as \"Authorization: Bearer <token>\")",
              "name": "Token",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "PasswordTextBox",
                "validate": "^\\s*\\S.{22,}\\S\\s*$"
              }
            },
            {
              "caption": "Default room",
              "name": "DefaultRoom",
              "width": "160px",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "caption": "Query only",
              "name": "ReadOnly",
              "width": "120px",
              "add": false,
              "edit": {
                "type": "CheckBox"
              }
            },
            {
              "caption": "Token also in the address",
              "name": "InPath",
              "width": "200px",
              "add": false,
              "edit": {
                "type": "CheckBox"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
